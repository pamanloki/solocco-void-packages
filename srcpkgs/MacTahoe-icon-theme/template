checksum=6330369e9e10a28cfc8da598ebf63a7204be705403519963ff84e1cb84719d35

do_install() {
	# Varian default (base + light + dark) plus cursor theme, ke DESTDIR.
	bash ./install.sh -d "${DESTDIR}/usr/share/icons"

	# Jangan ikut-bundle icon-theme.cache: trigger gtk-icon-cache milik xbps
	# yang meregenerasinya saat paket dipasang di sistem pengguna.
	find "${DESTDIR}/usr/share/icons" -name 'icon-theme.cache' -delete
}
