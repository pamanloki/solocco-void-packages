_tag="2026-09-10"
hostmakedepends="gtk-update-icon-cache"
depends="hicolor-icon-theme"
short_desc="MacOS Tahoe style icon theme for Linux desktops"
maintainer="solocco <noreply@github.com>"
license="GPL-3.0-only"
