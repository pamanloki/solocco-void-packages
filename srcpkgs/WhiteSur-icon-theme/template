# Template file for 'WhiteSur-icon-theme'
pkgname=WhiteSur-icon-theme
version=20260910
revision=1
_tag="2026-09-10"
hostmakedepends="gtk-update-icon-cache"
depends="hicolor-icon-theme"
short_desc="MacOS Big Sur style icon theme for Linux desktops"
maintainer="solocco <noreply@github.com>"
license="GPL-3.0-only"
homepage="https://github.com/vinceliuice/WhiteSur-icon-theme"
changelog="https://github.com/vinceliuice/WhiteSur-icon-theme/tags"
distfiles="https://github.com/vinceliuice/WhiteSur-icon-theme/archive/refs/tags/${_tag}.tar.gz"
checksum=406c9cd59705583f1754b0eaca96cc48bafda042b88ef143f16d8ae1820ecd95

do_install() {
	# Varian default (base + light + dark) ke DESTDIR.
	bash ./install.sh -d "${DESTDIR}/usr/share/icons"

	# Jangan ikut-bundle icon-theme.cache: trigger gtk-icon-cache milik xbps
	# yang meregenerasinya saat paket dipasang di sistem pengguna.
	find "${DESTDIR}/usr/share/icons" -name 'icon-theme.cache' -delete
}
