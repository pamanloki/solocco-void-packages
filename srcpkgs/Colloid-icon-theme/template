# Template file for 'Colloid-icon-theme'
pkgname=Colloid-icon-theme
version=20260810
revision=1
_tag="2026-08-10"
hostmakedepends="gtk-update-icon-cache"
depends="hicolor-icon-theme"
short_desc="Colloid icon theme for Linux desktops"
maintainer="solocco <noreply@github.com>"
license="GPL-3.0-only"
homepage="https://github.com/vinceliuice/Colloid-icon-theme"
changelog="https://github.com/vinceliuice/Colloid-icon-theme/tags"
distfiles="https://github.com/vinceliuice/Colloid-icon-theme/archive/refs/tags/${_tag}.tar.gz"
checksum=367c3ce3ab85721e41ca9aa4fccd1761ec236d1b8cd7daf65f5e9ec88c1a8a15

do_install() {
	# Varian default (base + light + dark) ke DESTDIR.
	bash ./install.sh -d "${DESTDIR}/usr/share/icons"

	# Jangan ikut-bundle icon-theme.cache: trigger gtk-icon-cache milik xbps
	# yang meregenerasinya saat paket dipasang di sistem pengguna.
	find "${DESTDIR}/usr/share/icons" -name 'icon-theme.cache' -delete
}
